#!name = kuwo (Loon 原生迁移)
#!desc = 从上游 QX/Surge 重写规则迁移；实际效果需真机验证
#!author = 原作者 / 规则迁移
#!homepage = https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Kuwo/kuwo.js
#!loon_version = 3.5.1(983)
#!system = iOS,iPadOS
#!date = 2026-10-22
# upstream: https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Kuwo/kuwo.js

[Rewrite]
^https?:\/\/mobilead\.kuwo\.cn\/EcomResourceServer\/get(IOSIsHideAd|Motor)\.do reject-200
^https?:\/\/rich\.kuwo\.cn\/(AdService|ecom)\/kaiping\/ad[iI]nfo reject-200
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d+\/(?:user\/)?(?:(?:config|adVip|pop|freeMode(?:\/h5)?)(?:\/))?(?:info|text|homePage|message|give\/time)(?:[/?#]|$) reject-200
^https?:\/\/appi\.kuwo\.cn\/kuwopay\vip-tab\/setting reject-200

[Script]
http-response ^https?:\/\/(?:vip1\.kuwo\.cn\/(?:vip\/enc\/user\/vip|vip\/v2\/user\/vip|(?:commercia\/)?vip\/(?:v2\/theme\?op=gd|player\/getStyleListByModel|hanger\/wear)|commercia\/vip\/dressCenter\/getTabList|commercia\/vipTab\/myTab\/base)|.+\.kuwo\.cn\/mobi\.s\?f=(?:kuwo|kwxs)\&q=|music(?:pay)?\.kuwo\.cn\/music\.pay\?newver=3|wapi\.kuwo\.cn\/openapi\/v1\/user\/freeMode\/give\/time|tingshu\.kuwo\.cn\/(?:api\/v2\/pay\/app\/getConfigInfo|v2\/api\/pay\/payInfo\/kwplayer\/payMiniBar)|audiobookpay\.kuwo\.cn\/a\.p|homepages\.kuwo\.cn(?:\.eo\.dnse1\.com)?\/mgxh\.s) script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Kuwo/kuwo.js, timeout=60, requires-body=true, tag=kuwo_1

[MITM]
hostname = *.kuwo.cn
