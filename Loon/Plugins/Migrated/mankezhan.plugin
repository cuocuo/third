[Script]
http-response ^https?:\/\/(member|comic|base).mkzcdn.com\/(user|chapter\/buy\/add|vote\/add|gift\/play\/add|advert\/app\/(read|user|task)).*$ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mankezhan.js, timeout=60, requires-body=true, tag=mankezhan_1
http-request ^https?:\/\/(comic|story).mkzcdn.com\/chapter\/(content\/v1|read\/check).*$ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mkztk.js, timeout=60, tag=mankezhan_2

[MITM]
hostname = member.mkzcdn.com, comic.mkzcdn.com, base.mkzcdn.com
