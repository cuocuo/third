[Rewrite]
^https?:\/\/[\w.-]+\/App\/Ad\/splashInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/noticeInfo reject-dict
^https?:\/\/[\w.-]+\/App\/IndexList\/homeFloatAd reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/activityInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/skitAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/countPopTotal reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/barsUserAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/ad\/config reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/vajraInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/bannerInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/bardCacheAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/barsIndexAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/comicAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/liveEventAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/novelAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Ad\/sportAdInfo reject-dict
^https?:\/\/[\w.-]+\/App\/Resource\/CommentAd\/show reject-dict

[Script]
http-response ^https?:\/\/[\w.-]+\/App\/Resource\/Config\/getNav script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_1
http-response ^https?:\/\/[\w.-]+\/App\/Ad\/barsPlayAdInfo script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_2
http-response ^https?:\/\/[\w.-]+\/App\/Ad\/playAdInfo script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_3
http-response ^https?:\/\/[\w.-]+\/App\/IndexPlay\/vodAdvertisement script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_4
http-response ^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/showOne script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_5
http-response ^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/vurlDetail script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TilingSales_getNav.js, timeout=60, requires-body=true, tag=TilingSales_ad_remove_6

