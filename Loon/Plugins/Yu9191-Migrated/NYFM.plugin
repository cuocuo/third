[Script]
http-response ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/itunes/NYFM.js, requires-body=true, timeout=30, tag=NYFM_response

[MITM]
hostname = buy.itunes.apple.com
