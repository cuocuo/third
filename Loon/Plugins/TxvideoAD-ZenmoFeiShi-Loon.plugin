# upstream_config: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TxvideoAD.snippet
# upstream_script: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js
# upstream_script_sha: 662851ff1034f652f67deab25d206216ef48ed2b
# verified: 2026-10-29; source rules and script unchanged; Loon binary adapter retained.
#!name = 腾讯视频净化 (ZenmoFeiShi · Loon)
#!desc = 腾讯视频开屏/片头广告、底部冗余 Tab 和个人中心页面净化；由 QX TxvideoAD.snippet 迁移。
#!author = TG@ZenMoFiShi (原作者) / ChatGPT (Loon 适配)
#!homepage = https://github.com/ZenmoFeiShi/Qx/blob/main/TxvideoAD.snippet
#!date = 2026-10-27
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)

# 上游 QX 脚本 SHA: 662851ff1034f652f67deab25d206216ef48ed2b
# Loon 原生二进制接口与 QX bodyBytes 不同，因此脚本使用本仓库内的适配版。
# 上游脚本变更后需要重新同步适配版，不能直接替换为 QX JS URL。

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/cuocuo/third/main/Loon/Scripts/TxvideoAD-ZenmoFeiShi-Loon.js") with tag="腾讯视频·请求处理", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/cuocuo/third/main/Loon/Scripts/TxvideoAD-ZenmoFeiShi-Loon.js") with tag="腾讯视频·播放数据", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$/ then script("https://raw.githubusercontent.com/cuocuo/third/main/Loon/Scripts/TxvideoAD-ZenmoFeiShi-Loon.js") with tag="腾讯视频·启动广告", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/ then script("https://raw.githubusercontent.com/cuocuo/third/main/Loon/Scripts/TxvideoAD-ZenmoFeiShi-Loon.js") with tag="腾讯视频·标签配置", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$/ then script("https://raw.githubusercontent.com/cuocuo/third/main/Loon/Scripts/TxvideoAD-ZenmoFeiShi-Loon.js") with tag="腾讯视频·灰度配置", timeout=30, requires_body=true, binary_body_mode=false

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
